{
  "name": "jarvis-dev",
  "private": true,
  "type": "module",
  "description": "Dev tooling for Jarvis: bundle-check edge functions and run unit tests. The app itself lives in web/.",
  "scripts": {
    "check:functions": "node scripts/check-functions.mjs",
    "typecheck": "tsc -p scripts/typecheck/tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "test:sql": "bash scripts/test-sql.sh",
    "token": "node scripts/gen-secret.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "esbuild": "0.28.2",
    "ical.js": "2.2.1",
    "typescript": "^5.6.3",
    "web-push": "^3.6.7"
  }
}
